NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://reliefopt:reliefopt@127.0.0.1:5432/reliefopt
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_ISSUER=reliefopt-central-command
JWT_AUDIENCE=reliefopt-client
JWT_EXPIRES_IN_SECONDS=28800
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
DEMO_PASSWORD=reliefopt
