{
  "name": "reliefopt",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "test": "npm run test:client && npm run test:server",
    "test:client": "node --import ./test/setup.js --test test/*.test.js",
    "test:server": "npm --prefix server run test",
    "test:coverage": "node --experimental-test-coverage --import ./test/setup.js --test test/*.test.js && npm --prefix server run test:coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check eslint.config.js playwright.config.js vite.config.js e2e test",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "dev": "vite",
    "build": "vite build",
    "build:android": "vite build --mode android",
    "preview": "vite preview",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server run start",
    "server:migrate": "npm --prefix server run migrate",
    "server:seed:demo": "npm --prefix server run seed:demo",
    "server:seed:warehouses": "npm --prefix server run seed:warehouses",
    "server:test": "npm --prefix server run test",
    "android:download-model": "node scripts/download-android-whisper-model.mjs",
    "android:sync-assets": "node scripts/sync-android-assets.mjs",
    "android:sync": "npm run build:android && npx cap sync android && npm run android:sync-assets",
    "android:build": "npm run android:sync && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
